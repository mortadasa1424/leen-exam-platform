# Which exam this build/deployment serves. Read at build time via
# import.meta.env.VITE_EXAM_ID by src/exams/active.js — see docs/PLATFORM.md's
# "Exam registry" section.
#
# Must be one of the ids registered in src/exams/registry.js (currently: gat).
# If unset, the app defaults to "gat" (today's behavior, unchanged).
# If set to an id not in the registry, the app fails immediately with an
# error listing the valid ids — it never silently falls back to gat.
#
# No secrets belong in this file or in any VITE_-prefixed variable: Vite
# inlines every VITE_ variable into the client bundle, so it is public.
VITE_EXAM_ID=gat
